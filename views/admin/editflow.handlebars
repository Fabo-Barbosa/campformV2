<div class="row justify-content-center">
  <div class="col-8">
    {{#each erros}}
      <div class="alert alert-danger">{{this.texto}}</div>
    {{/each}}

    <h2 class="mb-4 page-title">Editar Conta</h2>
    <div class="card border-light mb-3">
      <div class="card-body">
        <form action="/admin/flow/edit" method="post">
          <input type="hidden" name="id" value="{{flow._id}}" />
          <div class="form-group">
            <label for="inputEditCod">Código Matrix</label>
            <input
              type="number"
              class="form-control"
              id="inputEditCod"
              name="cod"
              value="{{flow.cod}}"
              disabled
            />
          </div>
          <div class="form-group">
            <label for="inputEditName">Nome</label>
            <input
              type="text"
              class="form-control"
              id="inputEditName"
              name="name"
              value="{{flow.name}}"
            />
          </div>
          <div class="form-group">
            <label for="inputEditDesc">Descrição</label>
            <input
              type="text"
              class="form-control"
              id="inputEditDesc"
              name="description"
              value="{{flow.description}}"
            />
          </div>
          <div class="form-group">
            <label for="selectAccount">Conta Vinculada</label>
            <select
              class="form-control"
              id="selectAccount"
              name="conta"
              required
            >
              <option
                value="{{flow.conta._id}}"
                selected
              >{{flow.conta.name}}</option>
              {{#each contas}}
                <option value="{{this._id}}">{{this.name}}</option>
              {{else}}
              {{/each}}
            </select>
          </div>
          <button
            type="submit"
            id="btnEditUser"
            class="btn orange-submit"
          >Editar Fluxo</button>
        </form>
      </div>
    </div>
  </div>
</div>