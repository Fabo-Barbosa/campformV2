<div class="row justify-content-center">
  <div class="col-8">
    {{#each erros}}
      <div class="alert alert-danger">{{this.texto}}</div>
    {{/each}}

    <h2 class="mb-4 page-title">Editar Flow</h2>
    <div class="card border-light mb-3">
      <div class="card-body">
        <form action="/admin/flow/edit" method="post" id="formCadastroFlow">
          <input type="hidden" name="id" value="{{flow._id}}" />
          <div class="form-group">
            <label for="inputEditCod">Código Matrix</label>
            <input
              type="number"
              class="form-control"
              id="inputEditCod"
              name="cod"
              value="{{flow.cod}}"
              disabled
            />
          </div>
          <div class="form-group">
            <label for="inputEditName">Nome</label>
            <input
              type="text"
              class="form-control"
              id="inputEditName"
              name="name"
              value="{{flow.name}}"
            />
          </div>
          <div class="form-group">
            <label for="inputEditDesc">Descrição</label>
            <input
              type="text"
              class="form-control"
              id="inputEditDesc"
              name="description"
              value="{{flow.description}}"
            />
          </div>
          <div class="form-group">
            <label for="selectAccount">Conta Vinculada</label>
            <select
              class="form-control"
              id="selectAccount"
              name="conta"
              required
            >
              <option
                value="{{flow.conta._id}}"
                selected
              >{{flow.conta.name}}</option>
              {{#each contas}}
                <option value="{{this._id}}">{{this.name}}</option>
              {{else}}
              {{/each}}
            </select>
          </div>
          <div class="mt-3">
            <label class="form-label fw-semibold">Flow Variáveis</label>

            <div class="dropdown mb-2">
              <button
                class="btn btn-outline-secondary btn-sm dropdown-toggle"
                type="button"
                data-toggle="dropdown"
                aria-expanded="false"
              >
                +
              </button>

              <ul class="dropdown-menu">
                <li>
                  <button
                    class="dropdown-item"
                    type="button"
                    data-add-variable="text"
                  >
                    Adicionar texto
                  </button>
                </li>

                <li>
                  <button
                    class="dropdown-item"
                    type="button"
                    data-add-variable="header"
                  >
                    Selecionar do cabeçalho da consulta
                  </button>
                </li>
              </ul>
            </div>

            <div id="variablesContainer" class="variables-container">
              {{#each flow.variables}}
                <div
                  class="variable-row row g-2 align-items-center mb-2"
                  data-variable-row="true"
                >
                  <div class="col-md-5">
                    <input
                      type="text"
                      class="form-control"
                      placeholder="Nome da variável"
                      value="{{@key}}"
                      data-variable-key="true"
                    />
                  </div>
                  <div class="col-md-5">
                    {{#if (initWith this "#")}}
                      <select
                        class="form-control select-variable-edit"
                        data-variable-value="true"
                      >
                        <option
                          value="{{this}}"
                          class="current-variable"
                        ></option>
                      </select>
                    {{else}}
                      <input
                        type="text"
                        class="form-control"
                        placeholder="Valor da variável"
                        data-variable-value="true"
                        value="{{this}}"
                      />
                    {{/if}}
                  </div>
                  <div class="col-md-2 d-grid">
                    <button
                      class="btn btn-outline-danger"
                      type="button"
                    >Remover</button>
                  </div>
                </div>
              {{else}}
              {{/each}}
            </div>

            <input type="hidden" name="variables" id="variablesJson" />
          </div>

          <template id="headerOptionsTemplate">
            {{#each headersConsulta}}
              <option value="#{{this.value}}">{{this.content}}</option>
            {{/each}}
          </template>

          <button
            type="submit"
            id="btnEditUser"
            class="btn orange-submit"
          >Editar Fluxo</button>
        </form>
      </div>
    </div>
  </div>
</div>