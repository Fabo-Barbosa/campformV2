<div class="row justify-content-center">
<div class="col-8">
{{#each erros}}
  <div class="alert alert-danger">{{this.texto}}</div>
{{/each}}

<h2 class="mb-4 page-title">Editar Usuário</h2>
<div class="card border-light mb-3">
  <div class="card-body">
    <form action="/admin/user/edit" method="post">
      <input type="hidden" name="id" value="{{_user._id}}" />
      <div class="form-group">
        <label for="inputEditName">Nome completo</label>
        <input
          type="text"
          class="form-control"
          id="inputEditName"
          name="name"
          value="{{_user.name}}"
        />
      </div>
      <div class="form-group">
        <label for="inputEditEmail">Email</label>
        <input
          type="email"
          class="form-control"
          id="inputEditEmail"
          name="email"
          value="{{_user.email}}"
        />
      </div>
      <div class="form-row">
        <div class="form-group col-md-6">
          <label for="inputEditUserName">Nome de usuário</label>
          <input
            type="text"
            class="form-control"
            id="inputEditUserName"
            name="username"
            value="{{_user.username}}"
            disabled
          />
        </div>
        <div class="form-group col-md-6">
          <label for="inputEditPassword">Trocar Senha</label>
          <input
            type="password"
            class="form-control"
            name="editpassword"
            id="inputEditPassword"
          />
        </div>
      </div>
      <div class="admin-submit">
        <div>
          <label for="inputEditEadmin">Administrador</label>
          <input type="checkbox" name="eAdmin" id="inputEditEadmin" value=1
          {{#if (eq _user.eAdmin 1)}}
            checked
          {{else}}
          {{/if}}/>
        </div>
        <div>
          <label for="inputEditAtivo">Ativo</label>
          <input type="checkbox" name="ativo" id="inputEditAtivo" value="true"
          {{#if (eq _user.Ativo True)}}
            checked
          {{else}}
          {{/if}}/>
        </div>
        <button
          type="submit"
          id="btnEditUser"
          class="btn orange-submit"
        >Salvar</button>
      </div>
    </form>
  </div>
</div>
</div>
</div>