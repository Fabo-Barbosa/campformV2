<div class="row justify-content-center">
<div class="col-8">
{{#each erros}}
  <div class="alert alert-danger">{{this.texto}}</div>
{{else}}
{{/each}}

<h2 class="mb-4 page-title">Cadastrar Conta</h2>
<div class="card border-light mb-3">
  <div class="card-body">
    <form action="/admin/account/register" method="post">
      <div class="form-group">
        <label for="inputCod">Código da Conta</label>
        <input
          type="number"
          class="form-control"
          id="inputCod"
          name="cod"
          placeholder="Ex. 5"
          required
        />
      </div>
      <div class="form-group">
        <label for="inputName">Nome</label>
        <input
          type="text"
          class="form-control"
          id="inputName"
          name="name"
          placeholder="Ex. Wlan Cobrança"
          required
        />
      </div>
      <div class="form-group">
        <label for="inputDescription">Descrição</label>
        <input
          type="text"
          class="form-control"
          id="inputDescription"
          name="description"
          placeholder="Ex. Conta especifica para cobrança."
          required
        />
      </div>
        <button
          type="submit"
          id="btnRegister"
          class="btn orange-submit"
        >Registrar</button>
      </div>
    </form>
  </div>
</div>
</div>
</div>