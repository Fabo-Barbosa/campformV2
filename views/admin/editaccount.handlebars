<div class="row justify-content-center">
  <div class="col-8">
    {{#each erros}}
      <div class="alert alert-danger">{{this.texto}}</div>
    {{/each}}

    <h2 class="mb-4 page-title">Editar Conta</h2>
    <div class="card border-light mb-3">
      <div class="card-body">
        <form action="/admin/account/edit" method="post">
          <input type="hidden" name="id" value="{{account._id}}" />
          <div class="form-group">
            <label for="inputEditCod">Código Matrix</label>
            <input
              type="number"
              class="form-control"
              id="inputEditCod"
              name="cod"
              value="{{account.cod}}"
              disabled
            />
          </div>
          <div class="form-group">
            <label for="inputEditName">Nome</label>
            <input
              type="text"
              class="form-control"
              id="inputEditName"
              name="name"
              value="{{account.name}}"
            />
          </div>
          <div class="form-group">
            <label for="inputEditDesc">Descrição</label>
            <input
              type="text"
              class="form-control"
              id="inputEditDesc"
              name="description"
              value="{{account.description}}"
            />
          </div>
          <button
            type="submit"
            id="btnEditUser"
            class="btn orange-submit"
          >Editar Conta</button>
        </form>
      </div>
    </div>
  </div>
</div>