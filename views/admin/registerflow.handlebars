<div class="row justify-content-center">
<div class="col-8">
{{#each erros}}
  <div class="alert alert-danger">{{this.texto}}</div>
{{else}}
{{/each}}

<h2 class="mb-4 page-title">Cadastrar Fluxo</h2>
<div class="card border-light mb-3">
  <div class="card-body">
    <form action="/admin/flow/register" method="post" id="formCadastroFlow">
      <div class="form-group">
        <label for="inputCod">Código do Fluxo</label>
        <input
          type="number"
          class="form-control"
          id="inputCod"
          name="cod"
          placeholder="Ex. 276"
          required
        />
      </div>
      <div class="form-group">
        <label for="inputName">Nome</label>
        <input
          type="text"
          class="form-control"
          id="inputName"
          name="name"
          placeholder="Ex. Fluxo de Cobrança v1"
          required
        />
      </div>
      <div class="form-group">
        <label for="inputDescription">Descrição</label>
        <input
          type="text"
          class="form-control"
          id="inputDescription"
          name="description"
          placeholder="Ex. Flow abre atendimento ao responder."
          required
        />
      </div>
        <div class="form-group">
            <label for="selectAccount">Conta Vinculada</label>
            <select class="form-control" id="selectAccount" name="conta" required>
                <option value="" selected disabled>Qual conta está vinculada?</option>
                {{#each contas}}
                    <option value="{{this._id}}">{{this.name}}</option>
                {{else}}
                    <option value="" selected disabled>Não há contas cadastradas.</option>
                {{/each}}
            </select>
      </div>
      <div class="mt-3">
        <label class="form-label fw-semibold">Flow Variáveis</label>

        <div class="dropdown mb-4">
          <button
            class="btn btn-outline-secondary btn-sm dropdown-toggle"
            type="button"
            data-toggle="dropdown"
            aria-expanded="false"
          >
            +
          </button>

          <div class="dropdown-menu">
            <li>
              <button class="dropdown-item" type="button" data-add-variable="text">
                Adicionar texto
              </button>
            </li>

            <li>
              <button class="dropdown-item" type="button" data-add-variable="header">
                Selecionar do cabeçalho da consulta
              </button>
            </li>
          </div>
        </div>

        <div id="variablesContainer" class="variables-container"></div>

        <input type="hidden" name="variables" id="variablesJson">
      </div>

      <template id="headerOptionsTemplate">
        {{#each headersConsulta}}
          <option value="#{{this.value}}">{{this.content}}</option>
        {{/each}}
      </template>

        <button
          type="submit"
          id="btnRegister"
          class="btn orange-submit"
        >Registrar</button>
      </div>
    </form>
  </div>
</div>
</div>
</div>