<div class="container page-wrapper">
  <div class="row">
    <div class="col-12">
      {{#if erro}}
        <div class="alert alert-danger">
          {{erro}}
        </div>
      {{/if}}
      {{#each erros}}
        <div class="alert alert-danger">{{this.texto}}</div>
      {{else}}
      {{/each}}
      <h1 class="page-title">Enviar Lista de Contatos</h1>
    </div>
  </div>

  <div class="row g-4">
    <!-- FORM PRINCIPAL -->
    <div class="col-lg-7">
      <div class="campaign-card">
        <form action="/campanha/discador/send" method="POST" id="campaignForm">
          <!-- PRIMEIROS CAMPOS -->
          <div class="mb-4">
            <label class="form-label section-label">Status de Contrato</label>

            <div class="status-grid">
              <div class="status-option">
                <div class="form-check">
                  <input
                    class="form-check-input statusContrato"
                    type="checkbox"
                    value="A"
                    id="statusAtivo"
                  />
                  <label
                    class="form-check-label"
                    for="statusAtivo"
                  >Ativo</label>
                </div>
              </div>

              <div class="status-option">
                <div class="form-check">
                  <input
                    class="form-check-input statusContrato"
                    type="checkbox"
                    value="B"
                    id="statusBloqueado"
                  />
                  <label
                    class="form-check-label statusContrato"
                    for="statusBloqueado"
                  >Bloqueado</label>
                </div>
              </div>

              <div class="status-option">
                <div class="form-check">
                  <input
                    class="form-check-input statusContrato"
                    type="checkbox"
                    value="C"
                    id="statusCancelado"
                  />
                  <label
                    class="form-check-label"
                    for="statusCancelado"
                  >Cancelado</label>
                </div>
              </div>

              <div class="status-option">
                <div class="form-check">
                  <input
                    class="form-check-input statusContrato"
                    type="checkbox"
                    value="S"
                    id="statusSuspenso"
                  />
                  <label
                    class="form-check-label"
                    for="statusSuspenso"
                  >Suspenso</label>
                </div>
              </div>
            </div>
          </div>

          <div class="mb-4">
            <div class="row g-3">
              <div class="col-md-6">
                <label for="faixaInicial" class="form-label section-label">Faixa
                  de Atraso Inicial</label>
                <input
                  type="number"
                  class="form-control"
                  id="faixaInicial"
                  placeholder="Ex: 1"
                  min="0"
                />
              </div>

              <div class="col-md-6">
                <label for="faixaFinal" class="form-label section-label">Faixa
                  de Atraso Final</label>
                <input
                  type="number"
                  class="form-control"
                  id="faixaFinal"
                  placeholder="Ex: 30"
                  min="0"
                />
              </div>
            </div>
          </div>

          <!-- BOTÃO CONSULTAR -->
          <div class="mb-4 d-grid d-md-flex">
            <button
              type="button"
              class="btn btn-secondary px-4"
              id="btnConsultar"
            >
              Consultar
            </button>
          </div>

          <div class="divider"></div>

          <!-- RESTANTE DOS CAMPOS -->
          <div class="row g-3">
            <div class="mb-3 col-12">
              <label for="name" class="form-label section-label">Nome da lista</label>
              <input type="text" name="name" id="name" class="form-control" />
            </div>
          </div>
          <div class="row g-3">
            <div class="mb-3 col-12">
              <label for="campaignSelect" class="form-label section-label">
                Campanhas 3C
              </label>

              <div class="d-flex gap-2">
                <select id="campaignSelect" class="form-control">
                  <option value="">Selecione uma campanha</option>

                  {{#each campanhas}}
                    <option value="{{this.id}}">
                      {{this.name}}
                    </option>
                  {{/each}}
                </select>

                <button
                  type="button"
                  id="btnAdicionarCampanha"
                  class="btn-adicao"
                  aria-label="Adicionar"
                >
                  <span class="icone-mais">+</span>
                </button>
              </div>
            </div>

            <div class="mb-3 col-12">

              <div id="campaignSelectedList" class="d-flex flex-column gap-2">
                <p id="emptyCampaignMessage" class="text-muted">
                  Nenhuma campanha selecionada.
                </p>
              </div>
            </div>

            <div class="col-12 d-flex justify-content-end mt-3">
              <button type="submit" class="btn orange-submit px-4">
                Criar Campanha
              </button>
            </div>
          </div>
        </form>
      </div>
    </div>

    <!-- SIDEBAR / RESUMO -->
    <div class="col-lg-5">
      <div class="summary-card">
        <h2 class="summary-title">Resumo da Campanha</h2>
        <hr />

        <div class="summary-block">
          <span class="summary-label">Pré-Visualização de clientes:</span>
          <div class="summary-muted" id="resumoClientesPreview">
            Visualizar os primeiros nomes da consulta
          </div>
        </div>

        <div class="summary-block">
          <span class="summary-label">Pessoas na Consulta (Estimativa):</span>
          <div class="summary-highlight" id="resumoTotalPessoas">0</div>
        </div>
      </div>
    </div>
  </div>
</div>